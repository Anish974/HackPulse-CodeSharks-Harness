{
  "name": "aegis-harness",
  "version": "1.0.0",
  "type": "module",
  "description": "Aegis: Enterprise Multi-Agent Governance OS with Human-in-the-Loop Policy Gatekeeper",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "start": "npm run start --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "seed": "npm run seed --workspace=apps/api"
  },
  "keywords": [
    "agentic-ai",
    "human-in-the-loop",
    "multi-agent",
    "monorepo",
    "governance",
    "security"
  ],
  "author": "Anish",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
